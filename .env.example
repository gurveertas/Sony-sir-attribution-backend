# ── Required ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
DATABASE_PUBLIC_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=re_xxx
EMAIL_FROM="Attribution <no-reply@yourdomain.com>"

# ── Payment-gateway connect (Stripe / PayPal / Razorpay) ────────────────────
# Public HTTPS base URL of THIS API. Gateways send webhooks here, so it must be reachable from the
# internet: no http://, no localhost / private IPs (use a tunnel such as ngrok for local testing).
APP_API_URL=https://api.yourdomain.com

# Dedicated key for encrypting stored secrets (gateway credentials, webhook signing secrets).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional for backward compatibility (falls back to JWT_SECRET), but strongly recommended in production.
# Safe to add later: secrets encrypted with the old JWT_SECRET-derived key are still readable, and are
# re-encrypted with the new key the next time they are saved. Do NOT change it afterwards without a migration.
ENCRYPTION_KEY=
