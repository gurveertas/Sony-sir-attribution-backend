# ── Required ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
DATABASE_PUBLIC_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=re_xxx
EMAIL_FROM="Attribution <no-reply@yourdomain.com>"

# ── Payment-gateway connect (Stripe / PayPal / Razorpay) ────────────────────
# Public HTTPS base URL of THIS API. Gateways send webhooks here, so it must be reachable from the
# internet: no http://, no localhost / private IPs (use a tunnel such as ngrok for local testing).
APP_API_URL=https://api.yourdomain.com

# Dedicated key for encrypting stored secrets (gateway credentials, webhook signing secrets).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional for backward compatibility (falls back to JWT_SECRET), but strongly recommended in production.
# Safe to add later: secrets encrypted with the old JWT_SECRET-derived key are still readable, and are
# re-encrypted with the new key the next time they are saved. Do NOT change it afterwards without a migration.
ENCRYPTION_KEY=

# ── Added for the v1 product scope ──────────────────────────────────────────
# Dashboard origin: CORS for the cookie session and the links in emails (verify, reset, invite).
FRONTEND_URL=https://app.yourdomain.com
# Comma-separated extra origins allowed to call the cookie-session API (staging, previews).
EXTRA_CORS_ORIGINS=

# Keyed (HMAC) hashing of customer emails / phones for matching. Strongly recommended in production;
# set it BEFORE the first real data arrives. Existing plain-SHA-256 hashes are still matched (fallback).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IDENTITY_HASH_KEY=

# New self-registered companies wait in "pending" until a platform admin approves them.
REQUIRE_WORKSPACE_APPROVAL=false
# Platform admins must use two-factor login (authenticator app). Leave on in production.
REQUIRE_PLATFORM_ADMIN_2FA=true
# Platform admins can only open company data inside a support session with a reason.
SUPPORT_ACCESS_REQUIRED=true
# Dashboards read the pre-computed daily rollups when they are up to date (freshness is shared by all
# instances through the database). Set false to always compute from raw rows.
USE_ROLLUPS_FOR_REPORTS=true
# Turn off the in-process queue / retry / sync workers (tests, one-off scripts).
DISABLE_BACKGROUND_WORKERS=false

# Ad platforms (scope 4.7): spend import over OAuth. Leave empty to use CSV upload only.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v18
